{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["app"],
    "resources": [
      "resources/upscale/*.txt",
      "resources/upscale/*.md",
      "resources/upscale/manifest.json",
      "resources/upscale/models/*"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "frameworks": [
        "resources/upscale/macos-aarch64/libncnn.dylib",
        "resources/upscale/macos-aarch64/libMoltenVK.dylib"
      ]
    }
  }
}
