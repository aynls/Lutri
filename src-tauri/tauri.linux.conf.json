{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["deb", "appimage"],
    "resources": [
      "resources/upscale/*.txt",
      "resources/upscale/*.md",
      "resources/upscale/manifest.json",
      "resources/upscale/models/*",
      "resources/upscale/linux-x86_64/*"
    ],
    "linux": {
      "deb": {
        "depends": ["libgomp1", "libvulkan1", "libdbus-1-3"],
        "recommends": ["gnome-keyring"]
      },
      "rpm": {
        "depends": ["libgomp", "vulkan-loader", "dbus-libs"]
      }
    }
  }
}
